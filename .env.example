# Resend API key. Provisioned by the Vercel Marketplace integration
# (`vercel integration add resend/resend-email`); pull it locally with
# `vercel env pull`. Server-side only — never prefix this with NEXT_PUBLIC_.
RESEND_API_KEY=

# Optional: where contact-form mail lands. Defaults to CONTACT_EMAIL in lib/copy.ts.
CONTACT_TO_EMAIL=

# Optional: the verified sender address. Defaults to portfolio@nhanxnguyen.com.
CONTACT_FROM_EMAIL=

# Optional: canonical origin for Open Graph URLs. On Vercel this is filled from
# VERCEL_PROJECT_PRODUCTION_URL; set it once there is a custom domain.
NEXT_PUBLIC_SITE_URL=
