# Optional: n8n webhook the contact form POSTs to.
# Leave unset and the form falls back to opening the visitor's mail client.
NEXT_PUBLIC_CONTACT_WEBHOOK=

# Optional: overrides the mailto address. Defaults to CONTACT_EMAIL in lib/copy.ts.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: canonical origin for Open Graph URLs. On Vercel this is filled from
# VERCEL_PROJECT_PRODUCTION_URL; set it once there is a custom domain.
NEXT_PUBLIC_SITE_URL=
